{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verbes_grecs_jeu_final_schema.json",
  "title": "Base finale des formes verbales grecques pour le jeu",
  "type": "object",
  "required": [
    "meta",
    "verbs"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "version",
        "nombre_lexemes"
      ]
    },
    "verbs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verbEntry"
      }
    }
  },
  "$defs": {
    "formList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "finiteParadigm": {
      "type": "object",
      "required": [
        "1s",
        "2s",
        "3s",
        "1p",
        "2p",
        "3p"
      ],
      "properties": {
        "1s": {
          "$ref": "#/$defs/formList"
        },
        "2s": {
          "$ref": "#/$defs/formList"
        },
        "3s": {
          "$ref": "#/$defs/formList"
        },
        "1p": {
          "$ref": "#/$defs/formList"
        },
        "2p": {
          "$ref": "#/$defs/formList"
        },
        "3p": {
          "$ref": "#/$defs/formList"
        }
      },
      "additionalProperties": false
    },
    "finiteTense": {
      "type": "object",
      "properties": {
        "active": {
          "$ref": "#/$defs/finiteParadigm"
        },
        "middle": {
          "$ref": "#/$defs/finiteParadigm"
        },
        "middle_passive": {
          "$ref": "#/$defs/finiteParadigm"
        },
        "passive": {
          "$ref": "#/$defs/finiteParadigm"
        }
      },
      "additionalProperties": false
    },
    "caseSet": {
      "type": "object",
      "required": [
        "nominative",
        "accusative",
        "genitive",
        "dative"
      ],
      "properties": {
        "nominative": {
          "$ref": "#/$defs/formList"
        },
        "accusative": {
          "$ref": "#/$defs/formList"
        },
        "genitive": {
          "$ref": "#/$defs/formList"
        },
        "dative": {
          "$ref": "#/$defs/formList"
        }
      },
      "additionalProperties": false
    },
    "numberSet": {
      "type": "object",
      "required": [
        "singular",
        "plural"
      ],
      "properties": {
        "singular": {
          "$ref": "#/$defs/caseSet"
        },
        "plural": {
          "$ref": "#/$defs/caseSet"
        }
      },
      "additionalProperties": false
    },
    "participleParadigm": {
      "type": "object",
      "required": [
        "masculine",
        "feminine",
        "neuter"
      ],
      "properties": {
        "masculine": {
          "$ref": "#/$defs/numberSet"
        },
        "feminine": {
          "$ref": "#/$defs/numberSet"
        },
        "neuter": {
          "$ref": "#/$defs/numberSet"
        }
      },
      "additionalProperties": false
    },
    "participleTense": {
      "type": "object",
      "properties": {
        "active": {
          "$ref": "#/$defs/participleParadigm"
        },
        "middle": {
          "$ref": "#/$defs/participleParadigm"
        },
        "middle_passive": {
          "$ref": "#/$defs/participleParadigm"
        },
        "passive": {
          "$ref": "#/$defs/participleParadigm"
        }
      },
      "additionalProperties": false
    },
    "infinitiveTense": {
      "type": "object",
      "properties": {
        "active": {
          "$ref": "#/$defs/formList"
        },
        "middle": {
          "$ref": "#/$defs/formList"
        },
        "middle_passive": {
          "$ref": "#/$defs/formList"
        },
        "passive": {
          "$ref": "#/$defs/formList"
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": [
        "common",
        "active",
        "middle",
        "middle_passive",
        "passive"
      ],
      "properties": {
        "common": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "middle": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "middle_passive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "verbEntry": {
      "type": "object",
      "required": [
        "id",
        "lemma",
        "translation",
        "forms",
        "quiz_eligibility",
        "verification_finale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "$ref": "#/$defs/translation"
        },
        "forms": {
          "type": "object",
          "required": [
            "indicative",
            "infinitive",
            "participle"
          ],
          "properties": {
            "indicative": {
              "type": "object",
              "required": [
                "present",
                "imperfect",
                "future",
                "aorist"
              ],
              "properties": {
                "present": {
                  "$ref": "#/$defs/finiteTense"
                },
                "imperfect": {
                  "$ref": "#/$defs/finiteTense"
                },
                "future": {
                  "$ref": "#/$defs/finiteTense"
                },
                "aorist": {
                  "$ref": "#/$defs/finiteTense"
                }
              },
              "additionalProperties": false
            },
            "infinitive": {
              "type": "object",
              "required": [
                "present",
                "imperfect",
                "future",
                "aorist"
              ],
              "properties": {
                "present": {
                  "$ref": "#/$defs/infinitiveTense"
                },
                "future": {
                  "$ref": "#/$defs/infinitiveTense"
                },
                "aorist": {
                  "$ref": "#/$defs/infinitiveTense"
                },
                "imperfect": {
                  "type": "object",
                  "required": [
                    "available",
                    "reason"
                  ],
                  "properties": {
                    "available": {
                      "const": false
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "participle": {
              "type": "object",
              "required": [
                "present",
                "future",
                "aorist"
              ],
              "properties": {
                "present": {
                  "$ref": "#/$defs/participleTense"
                },
                "future": {
                  "$ref": "#/$defs/participleTense"
                },
                "aorist": {
                  "$ref": "#/$defs/participleTense"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
